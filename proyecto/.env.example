# Copia este archivo como ".env" y coloca tus datos reales.
# El archivo .env NO se sube a git, así que tus contraseñas quedan seguras.

# Para enviar correos reales usa el backend SMTP.
# (En desarrollo, si borras esta línea, los correos se imprimen en la terminal)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail: usa una "CONTRASEÑA DE APLICACIÓN" (no tu contraseña normal).
# Se crea en: Google Cuenta > Seguridad > Verificación en dos pasos >
# Contraseñas de aplicaciones > generar una para "Correo".
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx

# Remitente que verá el cliente en los correos
DEFAULT_FROM_EMAIL=INTSHOT <tu_correo@gmail.com>
