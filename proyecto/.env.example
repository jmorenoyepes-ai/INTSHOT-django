# Copia este archivo como ".env" y coloca tus datos reales.
# El archivo .env NO se sube a git, así que tus contraseñas quedan seguras.
# En PythonAnywhere este archivo debe estar en la carpeta del proyecto
# (al lado de manage.py).

# Clave secreta de Django. OBLIGATORIA en producción. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Dominios permitidos, separados por coma (sin http://)
ALLOWED_HOSTS=tuusuario.pythonanywhere.com

# Déjalo en False en producción. En local se puede poner True.
DEBUG=False

# Días que dura un token de la API (apps móviles como Flutter)
API_TOKEN_DIAS=30

# Pon False solo si el servidor NO tiene HTTPS
SEGURIDAD_HTTPS=True


# Para enviar correos reales usa el backend SMTP.
# (En desarrollo, si borras esta línea, los correos se imprimen en la terminal)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail: usa una "CONTRASEÑA DE APLICACIÓN" (no tu contraseña normal).
# Se crea en: Google Cuenta > Seguridad > Verificación en dos pasos >
# Contraseñas de aplicaciones > generar una para "Correo".
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx

# Remitente que verá el cliente en los correos
DEFAULT_FROM_EMAIL=INTSHOT <tu_correo@gmail.com>
